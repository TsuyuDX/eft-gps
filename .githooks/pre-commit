#!/bin/sh
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
case "$branch" in
  main|master)
    echo "EFT GPS: stable branch is protected from accidental commits." >&2
    echo "Switch to development or create a feature/... branch." >&2
    exit 1
    ;;
  "")
    echo "EFT GPS: create a branch before committing changes to an old version." >&2
    exit 1
    ;;
esac
exit 0
