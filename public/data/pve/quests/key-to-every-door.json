беженцы, так и отряды ЧВК. По неподтверждённым данным, сотрудники TerraGroup также были эвакуированы через этот порт.","image":526,"svgPath":null,"points":[],"updatedAt":"2026-03-04T15:39:43.923Z","createdAt":"2025-12-27T14:10:33.844Z"}},"linkType":"internal"},"id":"69cb6e3300015d40d68e9439"},{"detail":0,"format":0,"mode":"normal","style":"","text":" и ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Ледокол","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Ледокол","relationTo":"maps","value":{"id":16,"normalizedName":"icebreaker","name":"Ледокол","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2026-08-14T12:33:42.668Z","createdAt":"2026-06-09T12:56:59.682Z"}},"linkType":"internal"},"id":"6a3558b70cc943f18d4eb1b0"},{"detail":0,"format":0,"mode":"normal","style":"","text":".","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"description":{"root":{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Элитные NPC:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Встречаются только на локациях Терминал и Ледокол, были добавлены в релизе игры 1.0","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Топовый гир и броня","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Агрессивный и точный AI","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Играют командой, флангуют, кидают гранаты","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":4}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Как с ними драться","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"heading","version":1,"tag":"h5"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"1. Не выходи в лоб","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Играй от укрытий, делай короткие пики.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"2. Держи дистанцию","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Средняя дистанция — safest вариант.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"3. Разделяй группу","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Выманивай по одному, не дерись сразу со всеми.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"4. Используй гранаты","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Заставляют двигаться и ломают позицию.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"5. Целься в уязвимые зоны","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Голова, лицо, грудь.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"6. Играй от звука","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Они хорошо читаются по шагам и действиям.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Рекомендуемый гир","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"heading","version":1,"tag":"h5"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Броня: 5–6 класс","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Патроны: с высоким пробитием","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Обязательно гранаты","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"image":null,"wiki":null,"updatedAt":"2026-06-19T15:07:35.101Z","createdAt":"2026-03-30T15:42:16.258Z"}},"linkType":"internal"},"id":"6a568a0bf969b476aa22a810"},{"detail":0,"format":0,"mode":"normal","style":"","text":" (небольшой шанс дропа) или с босса ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"The Wedge","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Клин","relationTo":"bosses","value":{"id":34,"normalizedName":"the-wedge","name":"Клин","bio":{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Клин (The Wedge)","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" — элитный полевой командир секретной фракции ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Black Division","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":", действующей в Норвинской области. До прибытия в Тарков он служил в британском спецназе ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"SAS","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":", на что указывают его характерный акцент и безупречные навыки ведения боя в замкнутых пространствах. Вся официальная информация о его прошлом стерта.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"В Таркове ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Клин","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"  возглавляет зачистку атомного ледокола ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"«Борей»","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" по приказу корпорации ","type":"text","version":1},{"detail":0,"format":2,"mode":"normal","style":"","text":"Paradigm Shipping","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":". Его подразделение не связано ни с USEC, ни с BEAR. Главная задача босса — ликвидация любых свидетелей и сокрытие секретных разработок TerraGroup на Ледоколе.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"description":{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Клин","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" — опасный босс, который мгновенно открывает огонь на поражение на средних и дальних дистанциях.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Ключ к успеху — агрессивный штурм с использованием гранат (осколочных и светошумовых), которые заставляют босса и его свиту менять позиции и прерывать стрельбу. Используйте бронебойные патроны высокого класса (не ниже 5-го уровня пробития), так как The Wedge и свита защищены топовой броней и имеют много ХП. Кроме того, противники также активно бросают флешки, имейте ввиду.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Цельтесь исключительно в голову, никогда не пикайте из-за одного и того же угла дважды — босс намертво удерживает прицел на вашей последней позиции и ликвидирует при повторном показе.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"На текущий момент наиболее эффективной тактикой является расстрел свиты с боссом под несколькими прокинутыми дымами, и ОБЯЗАТЕЛЬНО выкрутить \"Объемный свет\" на ультру в настройках графики, иначе вы в дымах ничего не увидите. Далее выманиваем на себя и расстреливаем, в дыму противники начинают сильно тупить. Есть подозрение, что разработчики пофиксят это, но на момент написания статьи этот способ работал. Также, если повезет, можно сразу дать залп с РШГ в конец коридора и сваншотить босса со свитой.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"image":null,"wiki":null,"updatedAt":"2026-06-08T15:50:29.659Z","createdAt":"2026-06-08T15:41:53.103Z"}},"linkType":"internal"},"id":"6a5689fef969b476aa22a80f"},{"detail":0,"format":0,"mode":"normal","style":"","text":" (высокий шанс дропа).","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Используйте его, чтобы открыть комнату, расположенную между ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"зоной испытаний","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" и ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"серверной","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":". ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Найти комнату на карте Лаборатория","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Аварийный код доступа на доске с панелью доступа","relationTo":"mapPoints","value":{"id":168,"map":{"id":10,"normalizedName":"the-lab","name":"Лаборатория","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-2