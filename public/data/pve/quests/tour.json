{"quest":{"id":"quest-cms-2","name":"Тур","normalizedName":"tour","type":"main","iconLink":"/api/media/file/tour-icon?preset=original","taskImageLink":"/api/media/file/tour-image.jpg?preset=original","trader":null,"guideCms":{"root":{"children":[{"type":"block","version":2,"format":"","fields":{"id":"3c1fa91b-78a5-46c2-b10a-f633019f3876","slider":[{"id":"692afe9f8bf1dc08e88a3558","image":{"id":17,"alt":"tur-1","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.205Z","createdAt":"2025-11-28T14:04:12.205Z","url":"/api/media/file/tur-1","thumbnailURL":"/api/media/file/tur-1?preset=sm","filename":"tur-1","mimeType":"application/octet-stream","filesize":240864,"width":null,"height":null},"caption":""},{"id":"692afe9f8bf1dc08e88a3559","image":{"id":16,"alt":"tur-2","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.141Z","createdAt":"2025-11-28T14:04:12.141Z","url":"/api/media/file/tur-2","thumbnailURL":"/api/media/file/tur-2?preset=sm","filename":"tur-2","mimeType":"application/octet-stream","filesize":263342,"width":null,"height":null},"caption":""},{"id":"692afe9f8bf1dc08e88a355a","image":{"id":12,"alt":"tur-3","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.020Z","createdAt":"2025-11-28T14:04:12.020Z","url":"/api/media/file/tur-3","thumbnailURL":"/api/media/file/tur-3?preset=sm","filename":"tur-3","mimeType":"application/octet-stream","filesize":358610,"width":null,"height":null},"caption":""},{"id":"692afe9f8bf1dc08e88a355b","image":{"id":10,"alt":"tur-4","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.005Z","createdAt":"2025-11-28T14:04:12.005Z","url":"/api/media/file/tur-4","thumbnailURL":"/api/media/file/tur-4?preset=sm","filename":"tur-4","mimeType":"application/octet-stream","filesize":337164,"width":null,"height":null},"caption":""}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"История представляет собой серию небольших поручений от торговцев, выполнение которых постепенно открывает доступ ко всем торговцам и картам. По мере прохождения, игрок знакомится с ключевыми персонажами игры и основными задачами, которые предстоит решать в процессе игры.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Изначально доступны контакты только с Терапевтом и Барахольщиком. После выполнения их небольших поручений, доступ к остальным торговцам открывается поэтапно: сначала Лыжник, затем Механик, Прапор и, наконец, Миротворец – в строго определённом порядке.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"2d42f851-becc-477a-93cb-bc500a08ce0c","slider":[{"id":"692afe9f8bf1dc08e88a355c","image":{"id":7,"alt":"tur-5","_objectKey":null,"updatedAt":"2025-11-28T14:04:11.797Z","createdAt":"2025-11-28T14:04:11.797Z","url":"/api/media/file/tur-5","thumbnailURL":"/api/media/file/tur-5?preset=sm","filename":"tur-5","mimeType":"application/octet-stream","filesize":260646,"width":null,"height":null},"caption":"Карта Берега с нужными точками"},{"id":"692afe9f8bf1dc08e88a355d","image":{"id":13,"alt":"tur-6","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.026Z","createdAt":"2025-11-28T14:04:12.026Z","url":"/api/media/file/tur-6","thumbnailURL":"/api/media/file/tur-6?preset=sm","filename":"tur-6","mimeType":"application/octet-stream","filesize":377404,"width":null,"height":null},"caption":"КПП Терминала"},{"id":"692afe9f8bf1dc08e88a355e","image":{"id":14,"alt":"tur-7","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.115Z","createdAt":"2025-11-28T14:04:12.115Z","url":"/api/media/file/tur-7","thumbnailURL":"/api/media/file/tur-7?preset=sm","filename":"tur-7","mimeType":"application/octet-stream","filesize":394384,"width":null,"height":null},"caption":"Интерком у дозорной башни"}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Квест «Найти вход в портовый Терминал» считается выполненным, когда игрок приближается к КПП-11 на локации Берег. ","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Подходите к Терминалу с осторожностью, поскольку пулеметчики, расположенные на вышках вокруг него, враждебны к игрокам и немедленно откроют огонь, если вы попадете в их поле зрения. Чтобы найти рацию, необходимую для связи с военными, выйдите из точки «Дорога на Таможню» и направляйтесь к Терминалу. Рация находится под одной из вышек.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Найти вышку у КПП на карте","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Дозорная башня у КПП","relationTo":"mapPoints","value":{"id":38,"map":{"id":1,"normalizedName":"shoreline","name":"Берег","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:08:10.862Z","createdAt":"2025-11-25T20:09:05.279Z"},"title":"Дозорная башня у КПП","slug":"dozornaya-bashnya-u-kpp","routeSlug":"dozornaya-bashnya-u-kpp-38","description":null,"type":"objective","images":null,"position":{"x":264.0359491046871,"y":-915.404565298055,"z":-50},"area":[],"quest":[{"id":2,"normalizedName":"tour","name":"Тур","type":"main","inAllModes":true,"kappaRequired":false,"lightkeeperRequired":false,"minPlayerLevel":1,"experience":0,"iconLink":3,"publishedAt":"2025-11-29T15:47:11.148Z","taskImageLink":205,"finishRewards":{"items":[],"money":null,"traderStanding":[]},"traderRelation":null,"nextQuests":[],"taskRequirements":{"docs":[],"hasNextPage":false},"events":[],"seasons":[],"updatedAt":"2026-06-15T16:05:38.961Z","createdAt":"2025-11-28T16:10:40.051Z","_status":"published"}],"updatedAt":"2026-03-26T10:12:51.497Z","createdAt":"2026-03-26T09:32:51.091Z"}},"linkType":"internal"},"id":"69c500b67a75d24585995fe4"}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"После беседы с военными на Терминале для продолжения выполнения квеста необходимо разблокировать доступ к локациям Маяк, Резерв и Улицы.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Чтобы получить доступ к Маяку, нужно заплатить 20 000 долларов Механику. Для доступа к Резерву требуется передать Прапору 5 жетонов ЧВК. Разблокировать доступ к Улицам можно, отдав Терапевту 250 тысяч рублей.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"326951f2-f0af-49f1-aaed-cb1274df8869","slider":[{"id":"692afe9f8bf1dc08e88a355f","image":{"id":8,"alt":"tur-8","_objectKey":null,"updatedAt":"2025-11-28T14:04:11.814Z","createdAt":"2025-11-28T14:04:11.814Z","url":"/api/media/file/tur-8","thumbnailURL":"/api/media/file/tur-8?preset=sm","filename":"tur-8","mimeType":"application/octet-stream","filesize":186169,"width":null,"height":null},"caption":""}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Кроме того, для завершения сюжетной линии «Тур» необходимо найти лабораторную ключ-карту.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"6091c437-1811-4a17-8529-fb820ad737d2","slider":[{"id":"692afe9f8bf1dc08e88a3560","image":{"id":15,"alt":"tur-9","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.134Z","createdAt":"2025-11-28T14:04:12.134Z","url":"/api/media/file/tur-9","thumbnailURL":"/api/media/file/tur-9?preset=sm","filename":"tur-9","mimeType":"application/octet-stream","filesize":226449,"width":null,"height":null},"caption":"Переход на Лабу на Заводе"},{"id":"692afe9f8bf1dc08e88a3561","image":{"id":11,"alt":"tur-10","_objectKey":null,"updatedAt":"2025-11-28T14:04:12.013Z","createdAt":"2025-11-28T14:04:12.013Z","url":"/api/media/file/tur-10","thumbnailURL":"/api/media/file/tur-10?preset=sm","filename":"tur-10","mimeType":"application/octet-stream","filesize":121994,"width":null,"height":null},"caption":"Переход на Лабу с Улиц"}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Получив ключ-карту, можно попасть в Лабораторию через один из переходов: на Заводе или на Улицах.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"6e9117f6-160c-49c6-8257-05af388a9154","slider":[{"id":"692afe9f8bf1dc08e88a3562","image":{"id":9,"alt":"tur-11","_objectKey":null,"updatedAt":"2025-11-28T14:04:11.964Z","createdAt":"2025-11-28T14:04:11.964Z","url":"/api/media/file/tur-11","thumbnailURL":"/api/media/file/tur-11?preset=sm","filename":"tur-11","mimeType":"application/octet-stream","filesize":135373,"width":null,"height":null},"caption":"Места для посещения на Лабе"}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"После входа в Лабораторию задание будет обновлено. Теперь необходимо посетить несколько мест на этой локации.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"69c5025932edab08ffdd3ae2","map":{"id":10,"normalizedName":"the-lab","name":"Лаборатория","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:09:22.709Z","createdAt":"2