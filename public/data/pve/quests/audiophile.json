":"tableRow","cells":[{"type":"tableCell","content":[{"alt":"Primorsky 46 underpass key icon","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_ru_gamepedia%2Fimages%2F9%2F9e%2FPrimorsky_46_underpass_key_icon.png%2Frevision%2Flatest%3Fcb%3D20230211131935","type":"image"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Ключ от перехода на Приморском 46-48","href":"/item/:mode/primorsky-46-48-skybridge-key","title":"Ключ от перехода на Приморском 46-48","type":"link"}],"isHeader":false},{"type":"tableCell","content":[{"content":"1\n","type":"text"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Требуется\n","type":"text"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Н/Д\n","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Ключ от квартиры №10 в жилом доме Приморский 48, где находится место сбора\n","type":"text"}],"isHeader":false}]},{"type":"tableRow","cells":[{"type":"tableCell","content":[{"alt":"AG guitar pick icon","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_ru_gamepedia%2Fimages%2Ff%2Ff8%2FAG_guitar_pick_icon.png%2Frevision%2Flatest%3Fcb%3D20230314233235","type":"image"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Медиатор с символами AG","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%9C%D0%B5%D0%B4%D0%B8%D0%B0%D1%82%D0%BE%D1%80_%D1%81_%D1%81%D0%B8%D0%BC%D0%B2%D0%BE%D0%BB%D0%B0%D0%BC%D0%B8_AG","title":"Медиатор с символами AG","type":"link"}],"isHeader":false},{"type":"tableCell","content":[{"content":"1\n","type":"text"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Требуется\n","type":"text"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Да","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Этот ","type":"text"},{"content":"Квестовый предмет","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%9A%D0%B2%D0%B5%D1%81%D1%82%D0%BE