ое подразделение) в Escape from Tarkov — это элитная, засекреченная частная военная структура, действующая в интересах корпорации TerraGroup. Они выполняют самые опасные и грязные задания, выступая как высококвалифицированные оперативники (рейдеры), охраняющие ключевые объекты, в игре появляются только на локациях ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Терминал","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Терминал","relationTo":"maps","value":{"id":15,"normalizedName":"terminal","name":"Терминал","description":"Южный порт Терминал находится под контролем ВС РФ с самого начала конфликта в Таркове. После изоляции города терминал был укреплён и стал основной точкой эвакуации, к которой стремились как гражданские беженцы, так и отряды ЧВК. По неподтверждённым данным, сотрудники TerraGroup также были эвакуированы через этот порт.","image":526,"svgPath":null,"points":[],"updatedAt":"2026-03-04T15:39:43.923Z","createdAt":"2025-12-27T14:10:33.844Z"}},"linkType":"internal"},"id":"69cb6e3300015d40d68e9439"},{"detail":0,"format":0,"mode":"normal","style":"","text":" и ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Ледокол","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Ледокол","relationTo":"maps","value":{"id":16,"normalizedName":"icebreaker","name":"Ледокол","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2026-08-14T12:33:42.668Z","createdAt":"2026-06-09T12:56:59.682Z"}},"linkType":"internal"},"id":"6a3558b70cc943f18d4eb1b0"},{"detail":0,"format":0,"mode":"normal","style":"","text":".","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"description