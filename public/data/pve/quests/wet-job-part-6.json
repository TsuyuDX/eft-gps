eOutcome":null,"objectives":[{"id":"6a5dea83a4dd339f77be89eb","description":"Устранить любую цель из марксманских винтовок калибра 7.62x51 с расстояния более 50 метров на локации Берег или Маяк","requiredKeys":null,"zones":[],"bodyParts":[],"count":15,"distance":{"value":50,"compareMethod":">="},"enemyHealthEffect":null,"maps":[{"id":"5704e554d2720bac5b8b456e","name":"Берег","normalizedName":"shoreline"},{"id":"5704e4dad2720bb55b8b4567","name":"Маяк","normalizedName":"lighthouse"}],"notWearing":[],"optional":false,"playerHealthEffect":null,"shotType":"kill","task":null,"targetNames":["любые цели"],"trader":null,"type":"shoot","usingWeapon":[{"id":"5aafa857e5b5b00018480968","name":"Винтовка Springfield Armory M1A 7.62x51","shortName":"M1A","normalizedName":"springfield-armory-m1a-762x51-rifle","iconLink":"https://assets.tarkov.dev/5aafa857e5b5b00018480968-icon.webp","gridImageLink":"https://assets.tarkov.dev/5aafa857e5b5b00018480968-grid-image.webp","craftsFor":[]},{"id":"5df8ce05b11454561e39243b","name":"Марксманская винтовка Knight's Armament Company SR-25 7.62x51","shortName":"SR-25","normalizedName":"knights-armament-company-sr-25-762x51-marksman-rifle","iconLink":"https://assets.tarkov.dev/5df8ce05b11454561e39243b-icon.webp","gridImageLink":"https://assets.tarkov.dev/5df8ce05b11454561e39243b-grid-image.webp","craftsFor":[]},{"id":"6932abeb5403890d0c09c926","name":"Марксманская винтовка Knight's Armament Company SR-25 7.62x51 (Taupe)","shortName":"SR-25(tau)","normalizedName":"knights-armament-company-sr-25-762x51-marksman-rifle-taupe","iconLink":"https://assets.tarkov.dev/6932abeb5403890d0c09c926-icon.webp","gridImageLink":"https://assets.tarkov.dev/6932abeb5403890d0c09c926-grid-image.webp","craftsFor":[]},{"id":"6176aca650224f204c1da3fb","name":"Марксманская винтовка HK G28 7.62x51","shortName":"G28","normalizedName":"hk-g28-762x51-marksman-rifle","iconLink":"https://assets.tarkov.dev/6176aca650224f204c1da3fb-icon.webp","gridImageLink":"https://assets.tarkov.dev/6176aca650224f204c1da3fb-grid-image.webp","craftsFor":[]},{"id":"5a367e5dc4a282000e49738f","name":"Марксманская винтовка Remington R11 RSASS 7.62x51","shortName":"RSASS","normalizedName":"remington-r11-rsass-762x51-marksman-rifle","iconLink":"https://assets.tarkov.dev/5a367e5dc4a282000e49738f-icon.webp","gridImageLink":"https://assets.tarkov.dev/5a367e5dc4a282000e49738f-grid-image.webp","craftsFor":[]}],"usingWeaponMods":[],"wearing":[]}],"inAllModes":true,"guide":[{"items":[[{"content":"Навык качается при использовании оружия, которое находится в разделе ","type":"text"},{"content":"Болтовые винтовки","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%9E%D1%80%D1%83%D0%B6%D0%B8%D0%B5#Болтовые_винтовки","title":"Оружие","type":"link"},{"content":".","type":"text"}],[{"content":"За каждое действие (перезарядка, попадание по цели, разрядка патронника, зарядка патронника) дается примерно 0,4 очка умения (значение может меняться от патча к патчу). Например, чтобы повысить навык на 1, вам надо 3 раза перезарядить винтовку.","type":"text"}],[{"content":"Самый простой способ - перезарядка магазинных винтовок. Берем 2 магазина, заряжаем в каждый хотя бы по 1 патрону (пустые магазины может не заряжать), и потом нажимаем ","type":"text"},{"content":"R","type":"text"},{"content":" для смены магазина.","type":"text"}],[{"content":"Разряжание патронника. Берем 1 подходящий патрон. Вынимаем из оружия магазин, и убираем его из слотов \"Карманы\" и \"Разгрузка\". Берем один патрон и кладем его в слот карманов или разгрузки. Нажимаем кнопку перезарядки (","type":"text"},{"content":"R","type":"text"},{"content":" по умолчанию), ЧВК заряжает 1 патрон в патронник. После этого нажимаем \"Разрядить патронник\" (","type":"text"},{"content":"CTRL+R","type":"text"},{"content":" по умолчанию), ЧВК разрядит оружие, но не потеряет патрон, а уберет его в карман или разгрузку (нужен пустой слот). Повторяем действия несколько раз, пока не наступит полная \"усталость\" прокачки навыка.","type":"text"}],[{"content":"Каждый уровень навыка больше предыдущего на 10 очков. То есть для прокачки с 0 на 1 уровень вам понадобится 10 очков навыка, с 1 на 2 - 20 очков, со 2 на 3 - 30 очков и так далее.","type":"text"}]],"ordered":false,"type":"list"}],"nextQuests":null}}