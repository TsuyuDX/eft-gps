{"item":{"description":"Специальный патрон 9х39мм БП гс (Индекс ГРАУ - 7Н12) с дозвуковой бронебойной пулей массой 15,5 грамм с сердечником из закаленной углеродистой стали, с двухслойной полуоболочкой, в стальной гильзе. Патрон БП (Бронебойная Пуля) был разработан в начале 2000-х годов на основе патрона 9x39мм СП-6 с целью улучшения его конструкции и бронепробиваемости, что привело к улучшению пробивной способности против специализированной брони 5-6 класса защиты, а также к значительному останавливающему действию. Однако, из-за своей конструкции, пуля имеет высокую вероятность отскока от различных поверхностей.","height":1,"iconLink":"https://assets.tarkov.dev/5c0d688c86f77413ae3407b2-icon.webp","id":"5c0d688c86f77413ae3407b2","image8xLink":"https://assets.tarkov.dev/5c0d688c86f77413ae3407b2-8x.webp","inAllModes":true,"inspectImageLink":"https://assets.tarkov.dev/5c0d688c86f77413ae3407b2-image.webp","name":"9x39мм БП гс","normalizedName":"9x39mm-bp-gs","shortName":"БП","wikiLink":"https://escapefromtarkov.fandom.com/ru/wiki/9x39мм_БП_гс","width":1,"containsItems":[],"properties":{"caliber":"Caliber9x39","penetrationPower":54,"damage":58,"armorDamage":69,"fragmentationChance":0.1,"penetrationChance":0.75,"initialSpeed":295,"projectileCount":1,"tracer":false,"tracerColor":"red","propertiesType":"ItemPropertiesAmmo","categories":[{"id":"5b47574386f77428ca22b33b","name":"Патроны","normalizedName":"rounds","imageLink":"https://assets.tarkov.dev/handbook-category-5b47574386f77428ca22b33b-icon.webp"},{"id":"5b47574386f77428ca22b346","name":"Боеприпасы","normalizedName":"ammo","imageLink":"https://assets.tarkov.dev/handbook-category-5b47574386f77428ca22b346-icon.webp"}],"weight":0.023},"minLevelForFlea":0,"trades":{"avg24hPrice":null,"bestBuyVendor":null,"bestSellVendor":{"currency":"RUB","price":585,"priceRUB":585,"vendor":{"normalizedName":"mechanic","minTraderLevel":null},"displayedValue":"585 ₽ "},"buyFleaSellTrader":null,"buyTraderSellFlea":null,"changeLast48h":null,