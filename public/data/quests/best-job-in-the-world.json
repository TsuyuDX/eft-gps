4c8b4572-icon.webp","gridImageLink":"https://assets.tarkov.dev/5644bd2b4bdc2d3b4c8b4572-grid-image.webp","craftsFor":[]},{"id":"5bf3e0490db83400196199af","name":"Автомат Калашникова АКС-74 5.45x39","shortName":"АКС-74","normalizedName":"kalashnikov-aks-74-545x39-assault-rifle","iconLink":"https://assets.tarkov.dev/5bf3e0490db83400196199af-icon.webp","gridImageLink":"https://assets.tarkov.dev/5bf3e0490db83400196199af-grid-image.webp","craftsFor":[]},{"id":"5ab8e9fcd8ce870019439434","name":"Автомат Калашникова АКС-74Н 5.45x39","shortName":"АКС-74Н","normalizedName":"kalashnikov-aks-74n-545x39-assault-rifle","iconLink":"https://assets.tarkov.dev/5ab8e9fcd8ce870019439434-icon.webp","gridImageLink":"https://assets.tarkov.dev/5ab8e9fcd8ce870019439434-grid-image.webp","craftsFor":[]}],"usingWeaponMods":[],"wearing":[]}],"inAllModes":true,"guide":[{"content":[{"content":"В этом квесте вам надо убить 30 любых противников (боты, боссы, не дружественные ЧВК) на любой карте используя автоматы серии АК. Для квеста точно подойдут следующие модели:\n","type":"text"}],"type":"paragraph"},{"items":[[{"content":"АК-74","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%90%D0%9A-74","title":"АК-74","type":"link"}],[{"content":"АК-74М","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%90%D0%9A-74%D0%9C","title":"АК-74М","type":"link"}],[{"content":"АК-74Н","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%90%D0%9A-74%D0%9D","title":"АК-74Н","type":"link"}],[{"content":"АКС-74","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%90%D0%9A%D0%A1-74","title":"АКС-74","type":"link"}],[{"content":"АКС-74Н","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%90%D0%9A%D0%A1-74%D0%9D","title":"АКС-74Н","type":"link"}]],"ordered":false,"type":"list"},{"content":[{"content":"Рекомендуемая точка для стрельбы район РЛС на ","type":"text"},{"content":"Резерве","href":"/quest/:mode/reserve","title":"Резерв","type":"link"},{"content":", так как оттуда открывается хороший вид на точки появления ","type":"text"},{"content":"Диких","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%94%D0%B8%D0%BA%D0%B8%D0%B5","title":"Дикие","type":"link"},{"content":" по всей карте.\n","type":"text"}],"type":"paragraph"},{"variant":"gallery","items":[[{"content":"\n\t\t\t","type":"text"},{"content":"Красными квадратами отмечены зоны, где часто перемещаются ЧВК и Дикие","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%A1%D0%BB%D1%83%D0%B6%D0%B5%D0%B1%D0%BD%D0%B0%D1%8F:%D0%97%D0%B0%D0%B3%D1%80%D1%83%D0%B7%D0%BA%D0%B0?wpDestFile=WorstJob.jpg","title":"Файл:WorstJob.jpg","type":"link"},{"content":"\n\t\t\t","type":"text"},{"content":"Красными квадратами отмечены зоны, где часто перемещаются ЧВК и Дикие","type":"text"},{"content":"\n\t\t","type":"text"}]],"ordered":false,"type":"list"},{"content":[{"content":"Рекомендуется использовать глушитель, так как громкая стрельба с этой позиции может привлечь нежелательное внимание.\nДикие (ИИ) имеют тенденцию обыскивать и обворовывать трупы. На короткое время они будут неподвижны во время мародерства, что позволит легко убить их выстрелом в голову. Убийство целей на открытом месте оставит их тела в качестве приманки, позволяя ИИ или игрокам обыскивать их, что даст вам возможность совершить больше убийств и установить интересующие вас зоны для стрельбы.\nИспользуйте оптический прицел с большим увеличением для большей точности и не трассирующие боеприпасы для лучшей скрытности.\n","type":"text"}],"type":"paragraph"}],"nextQuests":null}}