":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Для начала истории надо подойти ко входу в Лабиринт (за дверью, открываемой ключом от помещения «ООО КНОССОС»).","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Найти вход в Лабиринт на карте Берег","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Вход в Лабиринт","relationTo":"mapPoints","value":{"id":95,"map":{"id":1,"normalizedName":"shoreline","name":"Берег","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:08:10.862Z","createdAt":"2025-11-25T20:09:05.279Z"},"title":"Вход в Лабиринт","slug":"vhod-v-labirint","routeSlug":"vhod-v-labirint-95","description":null,"type":"objective","images":null,"position":{"x":-76.24657555563171,"y":-195.33622327061462,"z":-6},"area":[{"id":"69c69f9b86a78a73f436d8ac","x":-77.9047271321171,"y":-193.285016839443,"z":0},{"id":"69c69fa52e8a4b00c8163fb3","x":-78.0024142232481,"y":-196.996459242084,"z":0},{"id":"69c69f9d86a78a73f436d8ae","x":-74.3879918514014,"y":-197.191798315908,"z":0},{"id":"69c69f9e86a78a73f436d8af","x":-74.3879918514014,"y":-193.333851607899,"z":0}],"quest":[{"id":9,"normalizedName":"the-labyrinth","name":"Лабиринт","type":"main","inAllModes":true,"kappaRequired":false,"lightkeeperRequired":false,"minPlayerLevel":1,"experience":0,"iconLink":279,"publishedAt":"2025-12-09T12:14:35.915Z","taskImageLink":278,"finishRewards":{"items":[],"money":null,"traderStanding":[]},"traderRelation":null,"nextQuests":[],"taskRequirements":{"docs":[],"hasNextPage":false},"events":[],"seasons":[],"updatedAt":"2026-07-13T13:38:17.349Z","createdAt":"2025-12-09T12:14:03.621Z","_status":"published"}],"updatedAt":"2026-03-27T15:19:03.685Z","createdAt":"2026-03-27T15:18:32.885Z"}},"linkType":"internal"},"id":"69c7ac06e55d9a1df44b0589"}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Подождав около 36 часов, Егерь открывает нам бартер ключ-карты от Лабиринта за 1 самогон, 2 водки и 2 колбасы. Бартер доступен 2 раза за завоз. За это он просит нас узнать о группе бойцов ЧВК BEAR, которые штурмовали Лабиринт во время эвакуации. Успешно проведя операцию, группа утратила связь с командованием, а Лабиринт оказался закрыт.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"0eee726c-1235-42bd-a44c-aafe891e9755","slider":[{"id":"693812ac84e15f00c8995df8","image":{"id":264,"alt":"labirint-10","_objectKey":null,"updatedAt":"2025-12-09T12:13:49.794Z","createdAt":"2025-12-09T12:13:49.794Z","url":"/api/media/file/labirint-10.jpg","thumbnailURL":"/api/media/file/labirint-10.jpg?preset=sm","filename":"labirint-10.jpg","mimeType":"application/octet-stream","filesize":170080,"width":null,"height":null},"caption":"Бартер ключ-карты от Лабиринта у Егеря"}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"На Лабиринте надо будет пройтись по нескольким точкам, забирая записки и находя тела бойцов группы. Также, для открытия комнаты под номером 6 на карте вам понадобится забрать ключ из рук одного из лаборантов, помеченного на карте номером 2.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"69c7aeafe55d9a1df44b058a","map":{"id":13,"normalizedName":"the-labyrinth","name":"Лабиринт","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:10:34.173Z","createdAt":"20