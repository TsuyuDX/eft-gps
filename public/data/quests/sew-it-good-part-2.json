es":[],"count":2,"foundInRaid":true,"maps":[],"optional":false,"task":null,"trader":null,"type":"findItem","items":[{"id":"5648a69d4bdc2ded0b8b457b","name":"Разгрузочный жилет \"BlackRock Chest Rig\" (Серый)","shortName":"BlackRock","normalizedName":"blackrock-chest-rig-gray","iconLink":"https://assets.tarkov.dev/5648a69d4bdc2ded0b8b457b-icon.webp","gridImageLink":"https://assets.tarkov.dev/5648a69d4bdc2ded0b8b457b-grid-image.webp"}]},{"id":"5af07a0286f7747dba10d8ac","description":"Передать предметы","requiredKeys":null,"count":2,"foundInRaid":true,"optional":false,"task":null,"trader":null,"type":"giveItem","items":[{"id":"5648a69d4bdc2ded0b8b457b","name":"Разгрузочный жилет \"BlackRock Chest Rig\" (Серый)","shortName":"BlackRock","normalizedName":"blackrock-chest-rig-gray","iconLink":"https://assets.tarkov.dev/5648a69d4bdc2ded0b8b457b-icon.webp","gridImageLink":"https://assets.tarkov.dev/5648a69d4bdc2ded0b8b457b-grid-image.webp"}]}],"inAllModes":true,"guide":[{"content":[{"content":"Выньте бронеплиты!","type":"text"}],"type":"paragraph"},{"content":[{"content":"Чтобы понизить прочность бронежилета вам понадобится напарник. Возьмите с собой в рейд ","type":"text"},{"content":"Игрушечный пистолет 20x1мм","href":"/item/:mode/20x1mm-toy-gun","title":"Игрушечный пистолет 20x1мм","type":"link"},{"content":" и побольше патронов к нему. Из расчета 1 очко брони = 1 патрон. Надевайте бронежилет на напарника и стреляйте из игрушечного пистолета сначала в грудной арамидный пакет, когда понизите его прочность до 0. Если к тому времени общая прочность бронежилета не понизится до нужной величины, стреляйте в спинной арамидный пакет. Если вы будете стрелять в выбитый до 0 арамидный пакет, то напарник начнет получать урон. \n","type":"text"}],"type":"paragraph"},{"content":[{"content":"Плюсы: патроны дешевы, стоят 1 руб за единицу. Стрельба бесшумна. Если вы выбьете арамидный пакет в 0, то урон от пулек будет небольшой, и у вас не будет возможности случайно убить напарника. \n","type":"text"}],"type":"paragraph"},{"content":[{"content":"Минусы: При понижения прочности бронежилета ","type":"text"},{"content":"Бронежилет 6Б43 \"Забрало-Ш\" (Флора Цифра)","href":"/item/:mode/6b43-zabralo-sh-body-armor-emr","title":"Бронежилет 6Б43 \"Забрало-Ш\" (Флора Цифра)","type":"link"},{"content":" (для квеста) потребуется приличное количество времени, так как там много очков брони, а пистолет заряжается по 1 пульке.\n","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"content":"Необходимые предметы"},{"type":"table","rows":[{"type":"tableRow","cells":[{"type":"tableCell","content":[{"content":"Требуемые для квеста предметы\n","type":"text"}],"isHeader":true,"colSpan":6}]},{"type":"tableRow","cells":[{"type":"tableCell","content":[{"content":"Значок\n","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Название предмета\n","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Количество\n","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Требование\n","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Найдено в рейде","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%9D%D0%B0%D0%B9%D0%B4%D0%B5%D0%BD%D0%BE_%D0%B2_%D1%80%D0%B5%D0%B9%D0%B4%D0%B5","title":"Найдено в рейде","type":"link"}],"isHeader":true},{"type":"tableCell","content":[{"content":"Примечания\n","type":"text"}],"isHeader":true}]},{"type":"tableRow","cells":[{"type":"tableCell","content":[{"alt":"FORT armor icon","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_ru_gamepedia%2Fimages%2F9%2F90%2FFORT_armor_icon.png%2Frevision%2Flatest%3Fcb%3D20250227202838","type":"image"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Бронежилет 6Б43 \"Забрало-Ш\" (Флора Цифра)","href":"/item/:mode/6b43-zabralo-sh-body-armor-emr","title":"Бронежилет 6Б43 \"Забрало-Ш\" (Флора Цифра)","type":"link"}],"isHeader":false},{"type":"tableCell","content