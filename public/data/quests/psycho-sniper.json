n.webp","gridImageLink":"https://assets.tarkov.dev/5bfea6e90db834001b7347f3-grid-image.webp","craftsFor":[]},{"id":"673cab3e03c6a20581028bc1","name":"Снайперская винтовка Sako TRG M10 .338 LM","shortName":"TRG M10","normalizedName":"sako-trg-m10-338-lm-bolt-action-sniper-rifle","iconLink":"https://assets.tarkov.dev/673cab3e03c6a20581028bc1-icon.webp","gridImageLink":"https://assets.tarkov.dev/673cab3e03c6a20581028bc1-grid-image.webp","craftsFor":[]},{"id":"67c6de3ce39861860909e8e5","name":"Рычажная винтовка Marlin MXLR .308 ME","shortName":"MXLR","normalizedName":"marlin-mxlr-308-me-lever-action-rifle","iconLink":"https://assets.tarkov.dev/67c6de3ce39861860909e8e5-icon.webp","gridImageLink":"https://assets.tarkov.dev/67c6de3ce39861860909e8e5-grid-image.webp","craftsFor":[]},{"id":"61f7c9e189e6fb1a5e3ea78d","name":"Однозарядное ружье MP-18 7.62x54R","shortName":"MP-18","normalizedName":"mp-18-762x54r-single-shot-rifle","iconLink":"https://assets.tarkov.dev/61f7c9e189e6fb1a5e3ea78d-icon.webp","gridImageLink":"https://assets.tarkov.dev/61f7c9e189e6fb1a5e3ea78d-grid-image.webp","craftsFor":[]}],"usingWeaponMods":[],"wearing":[]}],"inAllModes":true,"guide":[{"content":[{"content":"После убийства последнего ЧВК надо обязательно выжить и выйти с локации! Если убить чвк ДО того как вкачается умение, то всё равно нельзя умирать пока не сдан квест. Поэтому сначала качайте умение, а только потом убивайте ЧВК.","type":"text"},{"content":" \n","type":"text"}],"type":"paragraph"},{"items":[[{"content":"Навык качается при использовании оружия, которое находится в разделе ","type":"text"},{"content":"Болтовые винтовки","href":"https://escapefromtarkov.fandom.com/ru/wiki/%D0%9E%D1%80%D1%83%D0%B6%D0%B8%D0%B5#Болтовые_винтовки","title":"Оружие","type":"link"},{"content":".","type":"text"}],[{"content":"За каждое действие (перезарядка, попадание по цели, разрядка патронника, зарядка патронника) дается примерно 0,4 очка умения (значение может меняться от патча к патчу). Например, чтобы повысить навык на 1, вам надо 3 раза перезарядить винтовку.","type":"text"}],[{"content":"Самый простой способ - перезарядка магазинных винтовок. Берем 2 магазина, заряжаем в каждый хотя бы по 1 патрону (пустые магазины может не заряжать), и потом нажимаем ","type":"text"},{"content":"R","type":"text"},{"content":" для смены магазина.","type":"text"}],[{"content":"Разряжание патронника. Берем 1 подходящий патрон. Вынимаем из оружия магазин, и убираем его из слотов \"Карманы\" и \"Разгрузка\". Берем один патрон и кладем его в слот карманов или разгрузки. Нажимаем кнопку перезарядки (","type":"text"},{"content":"R","type":"text"},{"content":" по умолчанию), ЧВК заряжает 1 патрон в патронник. После этого нажимаем \"Разрядить патронник\" (","type":"text"},{"content":"CTRL+R","type":"text"},{"content":" по умолчанию), ЧВК разрядит оружие, но не потеряет патрон, а уберет его в карман или разгрузку (нужен пустой слот). Повторяем действия несколько раз, пока не наступит полная \"усталость\" прокачки навыка.","type":"text"}],[{"content":"Каждый уровень навыка больше предыдущего на 10 очков. То есть для прокачки с 0 на 1 уровень вам понадобится 10 очков навыка, с 1 на 2 - 20 очков, со 2 на 3 - 30 очков и так далее.","type":"text"}]],"ordered":false,"type":"list"}],"nextQuests":null}}