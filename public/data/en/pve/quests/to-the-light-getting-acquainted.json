:1,"headerState":0,"rowSpan":1},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"1\n","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"format":"","type":"tablecell","version":1,"backgroundColor":null,"colSpan":1,"headerState":0,"rowSpan":1},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Handover item\n","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"format":"","type":"tablecell","version":1,"backgroundColor":null,"colSpan":1,"headerState":0,"rowSpan":1},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Yes","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"format":"","type":"tablecell","version":1,"backgroundColor":null,"colSpan":1,"headerState":1,"rowSpan":1},{"children":[{"children":[{"detail":0,"format":2,"mode":"normal","style":"","text":"This ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"quest item","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"url":"https://escapefromtarkov.fandom.com/wiki/Quests#Quest_items","linkType":"custom"}},{"detail":0,"format":2,"mode":"normal","style":"","text":" can only be found if the quest is active.When picked up, this item is transferred to the player's quest item inventory.If the player fails to extract with this item, they will lose it.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":2,"textStyle":""}],"format":"","type":"tablecell","version":1,"backgroundColor":null,"colSpan":1,"headerState":0,"rowSpan":1}],"format":"","type":"tablerow","version":1}],"format":"","type":"table","version":1,"colWidths":[92,92,92,92,92,92]},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"There are multiple spawns for the ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"V3 flash drive","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"url":"https://escapefromtarkov.fandom.com/wiki/Secure_Flash_drive_V3","linkType":"custom"}},{"detail":0,"format":0,"mode":"normal","style":"","text":" at the black (southern) chalet on ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Lighthouse","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Lighthouse","relationTo":"maps","value":{"id":5,"normalizedName":"lighthouse","name":"Lighthouse","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:07:00.583Z","createdAt":"2025-12-27T14:05:06.487Z"}},"linkType":"internal"}},{"detail":0,"format":0,"mode":"normal","style":"","text":". After obtaining it, you have to reflash the ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"transmitter","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Digital secure DSP radio transmitter","relationTo":"items","value":{"id":"62e910aaf957f2915e0a5e36","slug":"digital-secure-dsp-radio-transmitter","name":"Digital secure DSP radio transmitter","shortName":"DSPT","iconLink":"https://assets.tarkov.dev/62e910aaf957f2915e0a5e36-icon.webp","active":true,"updatedAt":"2026-09-10T13:33:00.274Z","createdAt":"2026-09-10T13:33:00.274Z"}},"linkType":"internal"}},{"detail":0,"format":0,"mode":"normal","style":"","text":" at the Intelligence Center level 2 in the ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Hideout","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"url":"/hideout/regular","linkType":"custom"}},{"detail":0,"format":0,"mode":"normal","style":"","text":". Electricity is required during the entire process, otherwise it will be interrupted. After the reflashing is done, the transmitter is fully functional and can be used to bypass the ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Claymores","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"url":"https://escapefromtarkov.fandom.com/wiki/Map_of_Tarkov#Claymores","linkType":"custom"}},{"detail":0,"format":0,"mode":"normal","style":"","text":" and ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Zryachiy","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Zryachiy","relationTo":"bosses","value":{"id":12,"normalizedName":"zryachiy","name":"Zryachiy","bio":{"root":{"type":"root","version":1,"children":[{"type":"paragraph","version":1,"indent":0,"format":"","direction":null,"textFormat":0,"textStyle":"","children":[{"type":"text","version":1,"detail":0,"format":0,"mode":"normal","style":"","text":"One of Tarkov's most mysterious figures. Virtually nothing is known about his past, except that he has sniper training and is remotely rumored to have been in hot zones in the Middle East and Africa many times.\nLong before the conflict, he became Lightkeeper's loyal lapdog and took an active part in \"establishing\" connections between Lightkeeper and all those with whom he interacted. He is known to be friendly with the Rogue group, as well as with the hooded men who draw mysterious symbols on the locations.\nZryachiy is very taciturn, though those who work with him usually understand him without words. There are many rumors about his eyes, some say that it is an inborn peculiarity, some point to certain eye drops that allow him to enhance his vision in the dark, giving his eyes this whiteness side effect. Despite the appearance, it seems that he earned his name precisely for his excellent eyesight, which is not surprising for a former military sniper."}]}],"direction":null,"format":"","indent":0}},"description":{"root":{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"To successfully eliminate Zryachiy, you first need a long-range rifle with high-magnification optics, as engaging him in close-quarters combat on the open isthmus is a guaranteed death sentence. It is best to take a position on the cliffs of the mainland from which the entire lighthouse is visible. Before opening fire, make absolutely sure that you see not only the boss himself but also his two guards covering the flanks.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"It is recommended to start the attack by eliminating the guards first. If you kill Zryachiy first, his followers will immediately change positions and begin extremely accurate suppressive fire, making them much harder to pinpoint afterward. Use calibers with high armor penetration and damage, such as 7.62x51mm or .338 Lapua, to ensure you take down targets with a single headshot.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"At night, the task is simplified thanks to thermal imaging, as the boss and his guards glow against the cold island background, and their detection range is slightly reduced. However, remember that at the first shots, they will begin actively using cover and parapets, so try to change your own position after each successful kill to avoid taking a retaliatory bullet to the head.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"image":null,"wiki":null,"updatedAt":"2026-03-31T13:06:47.503Z","createdAt":"2026-03-30T15:41:23.103Z"}},"linkType":"internal"}},{"detail":0,"format":0,"mode":"normal","style":"","text":" guarding the bridge to the lighthouse peninsula, allowing you to visit the lighthouse building and meet ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Lightkeeper","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"url":"https://escapefromtarkov.fandom.com/wiki/Lightkeeper","linkType":"custom"}},{"detail":0,"format":0,"mode":"normal","style":"","text":".\n","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Note: If not all members of your lobby-made group have an encoded transmitter, it will have the \"blocked\" state and the bridge can't be passed.\n","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"First/Second spawn on the first floor","type":"text","version":1}],"format":"","indent":0,"type":"heading","version":1,"tag":"h4"},{"type":"block","version":2,"format":"","fields":{"id":"bad16c9f-28c9-4a87-b61b-54dd77eb3cd8","blockName":"","slider":[{"id":"6aa4227d2e6e5600c8d3ebde","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F1%2F16%2FTo_the_Light_Getting_Acquainted_Chalet_Map.png%2Frevision%2Flatest%2Fscale-to-width-down%2F146%3Fcb%3D20260908214631","image":{"id":749,"alt":"To_the_Light_Getting_Acquainted_Chalet_Map","_objectKey":null,"updatedAt":"2026-09-2