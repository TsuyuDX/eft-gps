edName":"interchange"},{"id":"6733700029c367a3d40b02af","name":"The Labyrinth","normalizedName":"the-labyrinth"},{"id":"5704e5fad2720bc05b8b4567","name":"Reserve","normalizedName":"reserve"},{"id":"5714dc692459777137212e12","name":"Streets of Tarkov","normalizedName":"streets-of-tarkov"},{"id":"5b0fc42d86f7744a585f9105","name":"The Lab","normalizedName":"the-lab"},{"id":"5704e4dad2720bb55b8b4567","name":"Lighthouse","normalizedName":"lighthouse"},{"id":"65b8d6f5cdde2479cb2a3125","name":"Ground Zero 21+","normalizedName":"ground-zero-21"},{"id":"6a294a5b5eb5f9a1700417b7","name":"The Lab (Dark)","normalizedName":"the-lab-dark"}],"optional":false,"task":null,"trader":null,"type":"experience"},{"id":"5d9f035086f7741cac4a9713","description":"Survive and extract from the location","requiredKeys":null,"count":1,"exitStatus":["Survived"],"maps":[],"optional":false,"task":null,"trader":null,"type":"extract"}],"inAllModes":true,"guide":[{"content":[{"content":"You can consume certain items that decrease your hydration to quickly get into the dehydration state. For example, a ","type":"text"},{"content":"Jar of DevilDog mayo","href":"/item/:mode/jar-of-devildog-mayo","title":"Jar of DevilDog mayo","type":"link"},{"content":" gives -99 and a ","type":"text"},{"content":"Can of condensed milk","href":"/item/:mode/can-of-condensed-milk","title":"Can of condensed milk","type":"link"},{"content":" -65 hydration. You can also use the ","type":"text"},{"content":"gym","href":"/hideout/:mode","title":"Hideout","type":"link"},{"content":" module in your hideout to drain energy and hydration before starting a raid.\n","type":"text"}],"type":"paragraph"},{"content":[{"content":"Alternatively, if you play with friends, you can ask them to shoot you in the stomach, which will get you into the dehydration state too. Keep in mind that this will also decrease your energy rapidly.\n","type":"text"}],"type":"paragraph"},{"content":[{"content":"Don't forget to bring enough ","type":"text"},{"content":"Meds","href":"https://escapefromtarkov.fandom.com/wiki/Medical","title":"Medical","type":"link"},{"content":" or a ","type":"text"},{"content":"Propital regenerative stimulant injector","href":"/item/:mode/propital-regenerative-stimulant-injector","title":"Propital regenerative stimulant injector","type":"link"},{"content":" to outheal the damage, and enough ","type":"text"},{"content":"Drinks","href":"https://escapefromtarkov.fandom.com/wiki/Provisions","title":"Provisions","type":"link"},{"content":" to continue the raid afterwards.\n","type":"text"}],"type":"paragraph"},{"content":[{"content":"If you extract from the raid with the \"Run Through\" extraction status, the quest will not count as being completed. To avoid the \"Run Through\" status, gain at least 200 ","type":"text"},{"content":"EXP","href":"https://escapefromtarkov.fandom.com/wiki/EXP","title":"EXP","type":"link"},{"content":" in raid (by killing or looting) or be in raid for at least 7 minutes before extracting. If you happen to get a run through, you can survive and extract from another raid on any location to complete the quest.\n","type":"text"}],"type":"paragraph"},{"content":[{"content":"Zhivchik (живчик) translates roughly to \"lively\" or \"peppy\".\n","type":"text"}],"type":"paragraph"}],"nextQuests":[{"id":"5d25aed386f77442734d25d2","name":"The Survivalist Path - Unprotected but Dangerous","normalizedName":"the-survivalist-path-unprotected-but-dangerous","kappaRequired":false,"lightkeeperRequired":false,"taskImageLink":"https://assets.tarkov.dev/5d25aed386f77442734d25d2.webp","factionName":"Any","minPlayerLevel":9,"experience":10000,"wikiLink":"https://escapefromtarkov.fandom.com/wiki/The_Survivalist_Path_-_Unprotected_but_Dangerous","trader":{"name":"Jaeger","normalizedName":"jaeger","imageLink":"https://assets.tarkov.dev/5c0647fdd443bc2504c2d371.webp"},"taskRequirements":[{"status":["complete"],"task":{"id":"5d25bfd086f77442734d3007","name":"The Survivalist Path - Zhivchik","norma