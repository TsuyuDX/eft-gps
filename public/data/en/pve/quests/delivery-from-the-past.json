/customs","title":"Customs","type":"link"},{"content":" where the ","type":"text"},{"content":"Secure Folder 0022","href":"https://escapefromtarkov.fandom.com/wiki/Secure_Folder_0022","title":"Secure Folder 0022","type":"link"},{"content":" is located.\n","type":"text"}],"isHeader":false}]},{"type":"tableRow","cells":[{"type":"tableCell","content":[{"alt":"Docs 0022 icon","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F3%2F31%2FDocs_0022_icon.png%2Frevision%2Flatest%3Fcb%3D20220204154052","type":"image"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Secure Folder 0022","href":"https://escapefromtarkov.fandom.com/wiki/Secure_Folder_0022","title":"Secure Folder 0022","type":"link"}],"isHeader":false},{"type":"tableCell","content":[{"content":"1\n","type":"text"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Required\n","type":"text"}],"isHeader":false},{"type":"tableCell","content":[{"content":"Yes","type":"text"}],"isHeader":true},{"type":"tableCell","content":[{"content":"This ","type":"text"},{"content":"quest item","href":"https://escapefromtarkov.fandom.com/wiki/Quests#Quest_items","title":"Quests","type":"link"},{"content":" can only be found if the quest is active.","type":"text"},{"content":"When picked up, this item is transferred to the player's quest item inventory.","type":"text"},{"content":"If the player fails to extract with this item, they will lose it.","type":"text"}],"isHeader":false}]}]},{"content":[{"content":"To begin, you need to have the ","type":"text"},{"content":"Tarcone Director's office key","href":"/item/:mode/tarcone-directors-office-key","title":"Tarcone Director's office key","type":"link"},{"type":"mapPointLink","href":"/map/:mode/customs?q=591092ef86f7747bb8703422","pointId":"591092ef86f7747bb8703422","mapName":"Customs","mapNormalizedName":"customs","description":"Locate and obtain the valuable folder in Tarcone director's office on Customs"},{"content":". If you do not have one, you can find it within ","type":"text"},{"content":"drawers","href":"https://escapefromtarkov.fandom.com/wiki/Drawer","title":"Drawer","type":"link"},{"content":" or from ","type":"text"},{"content":"Scavs","href":"https://escapefromtarkov.fandom.com/wiki/Scavs","title":"Scavs","type":"link"},{"content":". It can also be bartered for with ","type":"text"},{"content":"Therapist","href":"https://escapefromtarkov.fandom.com/wiki/Therapist","title":"Therapist","type":"link"},{"content":". Once you have obtained one, head to ","type":"text"},{"content":"Customs","href":"/map/:mode/customs","title":"Customs","type":"link"},{"content":". The first place you want to visit is the red Paradigm warehouse on the east side of the map. The office is found at the top of the metal stairs. After unlocking the door there will be two rooms. The second room is the one containing the documents. Be warned though, to enter this room the door must be breached, which will create a lot of noise. After entering the room, go to the desk and look just under the table top, on top of the drawers. Leaning may help you to see it. Extract from ","type":"text"},{"content":"Customs","href":"/map/:mode/customs","title":"Customs","type":"link"},{"content":". If you die at any point after picking up the documents and you still have them in your in raid quest inventory, they will be lost and must be reacquired. If you don't want to do the second part of the quest immediately, you can move the documents into your off-raid quest inventory in the character menu under the \"tasks\" tab.\n","type":"text"}],"type":"paragraph"},{"variant":"gallery","items":[[{"content":"\n\t\t\t","type":"text"},{"alt":"Warehouse marked on map","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F4%2F4a%2FDelivery_from_the_past_Customs.png%2Frevision%2Flatest%3Fcb%3D20220214002541","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F4%2F4a%2FDelivery_from_the_past_Customs.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20220214002541","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"Warehouse marked on map","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"The warehouse","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F8%2F8a%2FCustoms-Factory1-Outside-3.png%2Frevision%2Flatest%3Fcb%3D20230117183410","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F8%2F8a%2FCustoms-Factory1-Outside-3.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20230117183410","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"The warehouse","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"The office","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F4%2F45%2FCustomsOffice.png%2Frevision%2Flatest%3Fcb%3D20230117184032","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F4%2F45%2FCustomsOffice.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20230117184032","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"The office","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"The second room","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F5e%2FFarming3Office.png%2Frevision%2Flatest%3Fcb%3D20230117182707","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F5e%2FFarming3Office.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20230117182707","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"The second room","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"Docs 0022 is under the desk, on top of the drawers","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fe%2Fe2%2FDocs_0022-Delivery_From_the_Past.png%2Frevision%2Flatest%3Fcb%3D20200220001533","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fe%2Fe2%2FDocs_0022-Delivery_From_the_Past.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20200220001533","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"Docs 0022 is under the desk, on top of the drawers","type":"text"},{"content":"\n\t\t","type":"text"}]],"ordered":false,"type":"list"},{"content":[{"content":"It's time to head to ","type":"text"},{"content":"Factory","href":"/map/:mode/factory","title":"Factory","type":"link"},{"content":". You can complete this during the daytime or nighttime. With the documents in your in raid quest inventory, head towards the Gate 3 extraction. To the left of the extraction is a short metal staircase leading to a sheet metal room. This is where you must place the documents. To place them you, must hold down your use key (default ","type":"text"},{"content":"F","type":"text"},{"content":") for 10 seconds. For safety, you should lie down when placing them to be out of sight from the doorway and windows. If you die before the timer finishes, you need to retrieve the documents again. Hence, try to make sure nobody is around to disturb while you place the documents (i.e. either kill all other PMCs or wait until they have left the raid). After the placement is complete, you have to extract from the raid. The \"Survived\" extraction status is not required. You do not have to survive and extract on the same raid that you planted the documents, it can be done in any ","type":"text"},{"content":"Factory","href":"/map/:mode/factory","title":"Factory","type":"link"},{"content":" raid.\n","type":"text"}],"type":"paragraph"},{"variant":"gallery","items":[[{"content":"\n\t\t\t","type":"text"},{"alt":"Break room marked on map","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fc%2Fcf%2FDelivery_from_the_past_Factory.png%2Frevision%2Flatest%3Fcb%3D20240824193029","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fc%2Fcf%2FDelivery_from_the_past_Factory.png%2Frevision%2Flatest%2Fscale-to-width-down%2F559%3Fcb%3D20240824193029","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"Break room marked on map","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"The sheet metal break room where you have to place the documents","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F5c%2FDelivery_from_the_past_dropoff.png%2Frevision%2Flatest%3Fcb%3D20240824175058","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F5c%2FDelivery_from_the_past_dropoff.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20240824175058","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"The sheet metal break room where you have to place the documents","type":"text"},{"content":"\n\t\t","type":"text"}]],"ordered":false,"type":"list"},{"type":"list","ordered":false,"items":[[{"type":"text","content":"Stash the package in the break room on the 2nd floor near Gate 3 on Factory"},{"type":"mapPointLink","href":"/map/:mode/factory?q=case_extraction","pointId":"case_extraction","mapName":"Factory","mapNormalizedName":"factory","description":"Stash the package in the break room on the 2nd floor near Gate 3 on Factory"}]]}],"images":[{"src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamep