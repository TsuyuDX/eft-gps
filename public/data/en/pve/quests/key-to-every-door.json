{"quest":{"id":"quest-cms-37","name":"Key to Every Door","normalizedName":"key-to-every-door","type":"side","iconLink":null,"taskImageLink":"/api/media/file/Key_to_Every_Door_Banner.png?preset=original","trader":{"name":"Skier","normalizedName":"skier","imageLink":"https://assets.tarkov.dev/58330581ace78e27b8b10cee.webp"},"guideCms":{"root":{"children":[{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Obtain the ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"TerraGroup Labs Arsenal Storage Room Key","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" from a ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Black Division","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Black Division","relationTo":"bosses","value":{"id":32,"normalizedName":"black-div","name":"Black Division","bio":{"root":{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"The Black Division is a highly skilled, mysterious, and elite tactical unit in Escape from Tarkov lore, primarily acting as the clandestine, elite \"cleanup crew\" for TerraGroup. Known for appearing in the ","type":"text","version":1},{"detail":0,"format":2,"mode":"normal","style":"","text":"Raid","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" series (Episode 5) and appears as a major threat only on the ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Terminal","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Terminal","relationTo":"maps","value":{"id":15,"normalizedName":"terminal","name":"Terminal","description":"The southern port Terminal has been under Russian Armed Forces control since the beginning of the Tarkov conflict. After the city was sealed off, the terminal was fortified and became the primary evacuation point, sought by both civilian refugees and PMC units. According to unconfirmed reports, TerraGroup personnel were also evacuated through this port.","image":526,"svgPath":null,"points":[],"updatedAt":"2026-03-04T15:39:43.923Z","createdAt":"2025-12-27T14:10:33.844Z"}},"linkType":"internal"},"id":"69cb6e5600015d40d68e943b"},{"detail":0,"format":0,"mode":"normal","style":"","text":"  and ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Icebreaker","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Icebreaker","relationTo":"maps","value":{"id":16,"normalizedName":"icebreaker","name":"Icebreaker","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2026-08-14T12:33:42.668Z","createdAt":"2026-06-09T12:56:59.682Z"}},"linkType":"internal"},"id":"6a3558d80cc943f18d4eb1b4"},{"detail":0,"format":0,"mode":"normal","style":"","text":" map, they represent a professional, western-equipped force that annihilates all witnesses.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"description":{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Elite NPCs:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Found only on the Terminal and Icebreaker location, added in the 1.0 release","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Top-tier gear and armor","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Aggressive and highly accurate AI","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Operate as a team, flank, and use grenades","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":4}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"How to fight them:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"1. Don’t take head-on fights","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Play around cover, use quick peeks.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"2. Keep your distance","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Mid-range is the safest option.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"3. Split the group","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Lure them one by one, avoid fighting all at once.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"4. Use grenades","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Force movement and break their positioning.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"5. Aim for weak spots","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Head, face, chest.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"6. Play off sound","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"They are predictable through footsteps and actions.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Recommended gear:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Armor: Class 5–6","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Ammo: High penetration","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Must-have: grenades","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"image":null,"wiki":null,"updatedAt":"2026-06-19T15:07:35.101Z","createdAt":"2026-03-30T15:42:16.258Z"}},"linkType":"internal"}},{"detail":0,"format":0,"mode":"normal","style":"","text":" (low drop chance) or from the boss ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"The Wedge","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"The Wedge","relationTo":"bosses","value":{"id":34,"normalizedName":"the-wedge","name":"The Wedge","bio":{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"The Wedge","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" is an elite field commander of the classified ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Black Division","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" faction operating within the Norvinsk region. Prior to his arrival in Tarkov, he served in the British Special Air Service (","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"SAS","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"), as indicated by his distinctive accent and flawless close-quarters combat skills. All official records of his past identity have been expunged.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"In Tarkov, The Wedge leads a containment operation aboard the atomic icebreaker ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"\"Boreas\"","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" under the orders of ","type":"text","version":1},{"detail":0,"format":2,"mode":"normal","style":"","text":"Paradigm Shipping","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":". His unit acts independently of both USEC and BEAR. The boss's primary mission is to eliminate all witnesses and suppress any classified data related to TerraGroup on the Icebreaker.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"description":{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"The Wedge","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" is a dangerous boss who instantly opens fire to kill at medium and long ranges.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"The key to success is an aggressive assault using grenades (HE and flashbangs) that force the boss and his guards to change positions and stop firing. Use high-tier armor-piercing rounds (at least class 5 penetration), as The Wedge and his guards are protected by top-tier armor and have high HP pools. Also, keep in mind that the enemies actively throw flashbangs too.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Aim strictly for the head and never peek the same angle twice — the boss locks his aim onto your last known position and will eliminate you instantly upon a re-peek.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Currently, the most effective tactic is to gun down the guards and the boss under several deployed smoke grenades, and you MUST set \"Volumetric Light\" to Ultra in your graphics settings; otherwise, you won't see anything in the smoke. Next, lure them toward you and shoot them down, as the enemies start to bug out heavily inside the smoke. There is a suspicion that the developers will patch this, but at the time of writing, this method works. Alternatively, if you get lucky, you can immediately fire an RShG rocket down the corridor to one-shot the boss along with his guards.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"image":null,"wiki":null,"updatedAt":"2026-06-08T15:50:29.659Z","createdAt":"2026-06-08T15:41:53.103Z"}},"linkType":"internal"},"id":"6a568b2cf969b476aa22a818"},{"detail":0,"format":0,"mode":"normal","style":"","text":" (high drop chance).","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Use the key to unlock the room located between the ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Testing Area","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" and the ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Server Room","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":". ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"You can find the room on the Labs map","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Emergency access code on the board with panel","relationTo":"mapPoints","value":{"id":168,"map":{"id":10,"normalizedName":"the-lab","name":"The Lab","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:09:22.709Z","createdAt":"2025-12-27T14:05:27.027Z"},"title":"Emergency access code on the board with panel","slug":"emergency-access-code-on-the-board-with-panel","routeSlug":"emergency-access-code-168","description":null,"type":"objective","images":null,"position":{"x":-336.9,"y":-133.12,"z":2},"area":[],"quest":[{"id":37,"normalizedName":"key-to-every-door","name":"Key to Every Door","type":"side","inAllModes":true,"kappaRequired":false,"lightkeeperRequired":false,"minPlayerLevel":1,"experience":0,"iconLink":null,"publishedAt":"2026-07-14T15:54:09.113Z","taskImageLink":623,"finishRewards":{"items":[],"money":null,"traderStanding":[]},"traderRelation":4,"nextQuests":[38],"taskRequirements":{"docs":[36],"hasNextPage":false},"events":[1],"seasons":[],"updatedAt":"2026-07-15T09:22:03.906Z","createdAt":"2026-07-14T15:55:55.003Z","_status":"published"}],"updatedAt":"2026-07-14T20:02:19.188Z","createdAt":"2026-07-14T16:04:08.136Z"}},"linkType":"internal"},"id":"6a568b45f969b476aa22a819"},{"detail":0,"format":0,"mode":"normal","style":"","text":".","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Check the code written on the whiteboard inside the room (it changes every raid).","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Use the control panel opposite the whiteboard to activate the extraction. During the event, there are two available extracts: ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Hangar","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" and ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Parking Gate","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":". Extract from the location to complete the objective.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":4}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"number","start":1,"tag":"ol"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Note:","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" The key is single-use and cannot be placed in your ","type":"text","version":1},{"detail":0,"format":1,"mode":"normal","style":"","text":"Secure Container","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":", but it can unlock most rooms that previously required individual keycards.\n","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"type":"block","version":2,"format":"","fields":{"id":"6a5750ea2ecec433fd4b4abf","blockName":"","slider":[{"id":"6a57503dd474e3615d624fa2","image":{"id":628,"alt":"key-to-every-door-1","_objectKey":null,"updatedAt":"2026-07-15T09:19:12.245Z","createdAt":"2026-07-15T09:19:12.245Z","url":"/api/media/file/key-to-every-door-1.webp","thumbnailURL":"/api/media/file/key-to-every-door-1.webp?preset=sm","filename":"key-to-every-door-1.webp","mimeType":"image/webp","filesize":53174,"width":1980,"height":1114},"caption":"Door to admin room"},{"id":"6a5750a4d474e3615d624fa3","image":{"id":629,"alt":"key-to-every-door-2","_objectKey":null,"updatedAt":"2026-07-15T09:19:52.081Z","createdAt":"2026-07-15T09:19:52.081Z","url":"/api/media/file/key-to-every-door-2.webp","thumbnailURL":"/api/media/file/key-to-every-door-2.webp?preset=sm","filename":"key-to-every-door-2.webp","mimeType":"image/webp","filesi