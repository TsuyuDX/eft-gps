"items":[],"offerUnlock":[],"skillLevelReward":[],"traderStanding":[{"standing":0.25,"trader":{"name":"Jaeger","normalizedName":"jaeger","imageLink":"https://assets.tarkov.dev/5c0647fdd443bc2504c2d371.webp"}}],"traderUnlock":[],"money":["+165,000 ₽ "]},"failureOutcome":null,"objectives":[{"id":"63929101744e452011470818","description":"Survive and extract from Streets of Tarkov through Klimov Street (Flare)","requiredKeys":null,"count":1,"exitStatus":["Survived"],"maps":[{"id":"5714dc692459777137212e12","name":"Streets of Tarkov","normalizedName":"streets-of-tarkov","extract":{"id":"d93214582e40ec0c37a7f55ba8777447f43e9b2f"}}],"optional":false,"task":null,"trader":null,"type":"extract"}],"inAllModes":true,"guide":[{"content":[{"content":"In this quest you have to extract from ","type":"text"},{"content":"Streets of Tarkov","href":"/map/:mode/streets-of-tarkov","title":"Streets of Tarkov","type":"link"},{"content":" via the \"Klimov Street\" extraction with the \"survived\" status. For the extraction to open, you have to shoot a green flare into the sky while being inside the signal flare area. Upon entering the signal flare area, a notifcation will pop up in the bottom right corner of the screen: ","type":"text"},{"alt":"KlimovStreetSignalAreaNote","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F2%2F22%2FKlimovStreetSignalAreaNote.png%2Frevision%2Flatest%3Fcb%3D20260330220637","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F2%2F22%2FKlimovStreetSignalAreaNote.png%2Frevision%2Flatest%3Fcb%3D20260330220637","type":"image"},{"content":" If the flare doesn't reach a certain height, the extraction won't open. If the flare was fired correctly, a new notification pops up: ","type":"text"},{"alt":"FlareSuccessNote","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F7%2F7f%2FFlareSuccessNote.png%2Frevision%2Flatest%3Fcb%3D20260603210733","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F7%2F7f%2FFlareSuccessNote.png%2Frevision%2Flatest%3Fcb%3D20260603210733","type":"image"},{"content":" You can use either the ","type":"text"},{"content":"handheld RSP-30 green flare","href":"/item/:mode/rsp-30-reactive-signal-cartridge-green","title":"RSP-30 reactive signal cartridge (Green)","type":"link"},{"content":" provided by ","type":"text"},{"content":"Jaeger","href":"https://escapefromtarkov.fandom.com/wiki/Jaeger","title":"Jaeger","type":"link"},{"content":" via in-game mail or a ","type":"text"},{"content":"26x75mm green flare cartridge","href":"/item/:mode/26x75mm-flare-cartridge-green","title":"26x75mm flare cartridge (Green)","type":"link"},{"content":" fired from a ","type":"text"},{"content":"signal pistol","href":"/item/:mode/zid-sp-81-26x75-signal-pistol","title":"ZiD SP-81 26x75 signal pistol","type":"link"},{"content":". If you use the ","type":"text"},{"content":"handheld RSP-30 green flare","href":"/item/:mode/rsp-30-reactive-signal-cartridge-green","title":"RSP-30 reactive signal cartridge (Green)","type":"link"},{"content":", make sure to aim it upwards, but not too much or it lands behind you. If you need additional flares you can buy them from Jaeger. To avoid the \"run through\" status, gain at least 200 ","type":"text"},{"content":"EXP","href":"https://escapefromtarkov.fandom.com/wiki/EXP","title":"EXP","type":"link"},{"content":" in raid (by killing or looting) or be in raid for at least 7 minutes before extracting.\n","type":"text"}],"type":"paragraph"},{"variant":"gallery","items":[[{"content":"\n\t\t\t","type":"text"},{"alt":"Extraction marked on map","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fb%2Fb4%2FCeaseFireMap.png%2Frevision%2Flatest%3Fcb%3D20251004222804","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wiki