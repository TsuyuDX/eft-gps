{"quest":{"id":"quest-cms-61","name":"Desperate Assault","normalizedName":"desperate-assault","type":"side","iconLink":null,"taskImageLink":"/api/media/file/Wrench_and_Waterboarding_Banner-1.png?preset=original","trader":{"name":"Mechanic","normalizedName":"mechanic","imageLink":"https://assets.tarkov.dev/5a7c2eca46aef81a7ca2145d.webp"},"guideCms":{"root":{"direction":null,"type":"root","version":1,"indent":0,"format":"","children":[{"type":"paragraph","version":1,"indent":0,"format":"left","textFormat":0,"textStyle":"","children":[{"type":"text","version":1,"detail":0,"mode":"normal","format":0,"style":"","text":"In this quest you have to eliminate 15 "},{"type":"link","version":1,"direction":null,"format":null,"indent":0,"rel":null,"target":null,"fields":{"doc":{"relationTo":"bosses","value":{"id":32,"normalizedName":"black-div","name":"Black Division","bio":{"root":{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"The Black Division is a highly skilled, mysterious, and elite tactical unit in Escape from Tarkov lore, primarily acting as the clandestine, elite \"cleanup crew\" for TerraGroup. Known for appearing in the ","type":"text","version":1},{"detail":0,"format":2,"mode":"normal","style":"","text":"Raid","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":" series (Episode 5) and appears as a major threat only on the ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Terminal","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Terminal","relationTo":"maps","value":{"id":15,"normalizedName":"terminal","name":"Terminal","description":"The southern port Terminal has been under Russian Armed Forces control since the beginning of the Tarkov conflict. After the city was sealed off, the terminal was fortified and became the primary evacuation point, sought by both civilian refugees and PMC units. According to unconfirmed reports, TerraGroup personnel were also evacuated through this port.","image":526,"svgPath":null,"points":[],"updatedAt":"2026-03-04T15:39:43.923Z","createdAt":"2025-12-27T14:10:33.844Z"}},"linkType":"internal"},"id":"69cb6e5600015d40d68e943b"},{"detail":0,"format":0,"mode":"normal","style":"","text":"  and ","type":"text","version":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Icebreaker","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"label":"Icebreaker","relationTo":"maps","value":{"id":16,"normalizedName":"icebreaker","name":"Icebreaker","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2026-08-14T12:33:42.668Z","createdAt":"2026-06-09T12:56:59.682Z"}},"linkType":"internal"},"id":"6a3558d80cc943f18d4eb1b4"},{"detail":0,"format":0,"mode":"normal","style":"","text":" map, they represent a professional, western-equipped force that annihilates all witnesses.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":null,"format":"","indent":0,"type":"root","version":1}},"description":{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Elite NPCs:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Found only on the Terminal and Icebreaker location, added in the 1.0 release","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Top-tier gear and armor","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Aggressive and highly accurate AI","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Operate as a team, flank, and use grenades","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":4}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"How to fight them:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"1. Don’t take head-on fights","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Play around cover, use quick peeks.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"2. Keep your distance","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Mid-range is the safest option.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"3. Split the group","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Lure them one by one, avoid fighting all at once.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"4. Use grenades","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Force movement and break their positioning.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"5. Aim for weak spots","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Head, face, chest.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"6. Play off sound","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"They are predictable through footsteps and actions.","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Recommended gear:","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Armor: Class 5–6","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Ammo: High penetration","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Must-have: grenades","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"listitem","version":1,"value":3}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":null,"format":"","indent":0,"type":"root"