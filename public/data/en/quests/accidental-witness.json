esize":146290,"width":null,"height":null},"caption":"Anastasia's mailbox"}],"blockType":"slider"}},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"In her mailbox, there is a letter and a newspaper sticking out. Picking them up and reading them will give us a new lead - we now need to find the courier Pasha, who, according to the letter, knows where to find Kozlov. Pasha, or rather his belongings, can be found at Customs, behind a two-story dormitory.","type":"text","version":1}],"format":"left","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Find the location of Pasha's body with envelope","type":"text","version":1}],"direction":null,"format":"","indent":0,"type":"link","version":3,"fields":{"doc":{"relationTo":"mapPoints","value":{"id":64,"map":{"id":3,"normalizedName":"customs","name":"Customs","description":null,"image":null,"svgPath":null,"points":[],"updatedAt":"2025-12-27T14:06:59.783Z","createdAt":"2025-12-27T13:54:24.137Z"},"title":"The envelope of Pasha's body","slug":"konvert-u-tela-pashi","routeSlug":"konvert-u-tela-pashi-64","description":null,"type":"item","images":null,"position":{"x":138.1427277451046,"y":277.64353809341054,"z":0.429180861},"area":[],"quest":[{"id":5,"normalizedName":"accidental-witness","name":"Accidental Witness","type":"main","inAllModes":true,"kappaRequired":false,"lightkeeperRequired":false,"minPlayerLevel":1,"experience":0,"iconLink":114,"publishedAt":"2025-12-03T08:17:37.235Z","taskImageLink":207,"finishRewards":{"items":[],"money":null,"traderStanding":[]},"traderRelation":null,"nextQuests":[],"taskRequirements":{"docs":[],"hasNextPage":false},"events":[],"seasons":[],"updatedAt":"2026-07-11T18:30:09.289Z","createdAt":"2025-12-03T08:16:51.549Z","_status":"published"}],"updatedAt":"2026-03-26T14:35:11.940Z","createdAt":"2026-03-26T14:34:46.781Z"}},"newTab":true,"linkType":"internal"},"id":"69c547bf