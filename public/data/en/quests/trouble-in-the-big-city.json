 ","type":"text"},{"content":"handheld RSP-30 yellow flare","href":"/item/:mode/rsp-30-reactive-signal-cartridge-yellow","title":"RSP-30 reactive signal cartridge (Yellow)","type":"link"},{"content":", make sure to aim it upwards, but not too much or it lands behind you.\n","type":"text"}],"type":"paragraph"},{"variant":"gallery","items":[[{"content":"\n\t\t\t","type":"text"},{"alt":"Convoy location and flare area marked on map","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fa%2Fa2%2FTroubleMap.png%2Frevision%2Flatest%3Fcb%3D20250729091046","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2Fa%2Fa2%2FTroubleMap.png%2Frevision%2Flatest%2Fscale-to-width-down%2F331%3Fcb%3D20250729091046","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"Convoy location and flare area marked on map","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"Cargo truck trailer with grate door","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F54%2FTroubleBigCity_MarkSpot.png%2Frevision%2Flatest%3Fcb%3D20260406230059","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F54%2FTroubleBigCity_MarkSpot.png%2Frevision%2Flatest%2Fscale-to-width-down%2F450%3Fcb%3D20260406230059","type":"image"},{"content":"\n\t\t\t","type":"text"},{"content":"Cargo truck trailer with grate door","type":"text"},{"content":"\n\t\t","type":"text"}],[{"content":"\n\t\t\t","type":"text"},{"alt":"Marker spot","previewSrc":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F54%2FTroubleBigCity_MarkSpot2.png%2Frevision%2Flatest%3Fcb%3D20260406225645","src":"/api/wiki/image?url=https%3A%2F%2Fstatic.wikia.nocookie.net%2Fescapefromtarkov_gamepedia%2Fimages%2F5%2F54%2FTrouble