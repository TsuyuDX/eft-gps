{"item":{"description":"Патрон 7.62x39мм БП гж (Индекс ГРАУ - 7Н23) с бронебойной пулей массой 7,9 грамм с сердечником из закаленной углеродистой стали, с плакированной томпаком биметаллической оболочкой, в биметаллической гильзе. Пуля БП была разработана в 1990-х годах на основе 7,62x39мм ПС гж для улучшения ее конструкции и пробивной способности. Был выбран более длинный и узкий армированный стальной сердечник, позволяющий пробивать броню базового и среднего уровня защиты, обеспечивая значительное останавливающее воздействие. Однако, из-за своей конструкции, пуля имеет высокую вероятность отскока от различных поверхностей.","height":1,"iconLink":"https://assets.tarkov.dev/59e0d99486f7744a32234762-icon.webp","id":"59e0d99486f7744a32234762","image8xLink":"https://assets.tarkov.dev/59e0d99486f7744a32234762-8x.webp","inAllModes":true,"inspectImageLink":"https://assets.tarkov.dev/59e0d99486f7744a32234762-image.webp","name":"7.62x39мм БП гж","normalizedName":"762x39mm-bp-gzh","shortName":"БП","wikiLink":"https://escapefromtarkov.fandom.com/ru/wiki/7.62x39мм_БП_гж","width":1,"containsItems":[],"properties":{"caliber":"Caliber762x39","penetrationPower":47,"damage":58,"armorDamage":63,"fragmentationChance":0.12,"penetrationChance":0.6,"initialSpeed":730,"projectileCount":1,"tracer":false,"tracerColor":"red","propertiesType":"ItemPropertiesAmmo","categories":[{"id":"5b47574386f77428ca22b33b","name":"Патроны","normalizedName":"rounds","imageLink":"https://assets.tarkov.dev/handbook-category-5b47574386f77428ca22b33b-icon.webp"},{"id":"5b47574386f77428ca22b346","name":"Боеприпасы","normalizedName":"ammo","imageLink":"https://assets.tarkov.dev/handbook-category-5b47574386f77428ca22b346-icon.webp"}],"weight":0.016},"minLevelForFlea":0,"trades":{"avg24hPrice":null,"bestBuyVendor":null,"bestSellVendor":{"currency":"RUB","price":499,"priceRUB":499,"vendor":{"normalizedName":"mechanic","minTraderLevel":null},"displayedValue":"499 ₽ "},"buyFleaSellTrader":null,"buyTraderSellFlea":nul